#!/bin/sh
# Fast local checks before every push: lint, unit tests with the coverage floor, and the production build.
# E2E, accessibility, keyboard and visual run in CI (the required checks block the merge); run them locally with
# `npm run verify` when a change touches what the browser shows.
set -e
echo "pre-push: lint, unit and build (E2E and visual run in CI)..."
npm run -s verify:fast
